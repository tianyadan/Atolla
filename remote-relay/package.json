{
  "name": "atolla-remote-relay",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev:local": "bash scripts/dev-local.sh",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "ios": "npm run ios -w web",
    "cap:sync": "npm run cap:sync -w web"
  }
}
